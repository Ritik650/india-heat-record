          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name, state, lat, lon, round(mean_rate, 2) AS rate, round(tmax_rate, 2) AS days, round(tmin_rate, 2) AS nights, months, if(suspect = 1, 'Check: day and night rates differ widely', 'OK') AS flag FROM heat.dash_station_rates",
