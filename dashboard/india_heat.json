          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name AS Station, state AS State, round(mean_rate, 2) AS `Rate`, round(ci_low, 2) AS `Low`, round(ci_high, 2) AS `High`, multiIf(repeat_group = 'jumped', 'Stepped at 2011', repeat_group = 'early', 'Stepped around 1990', repeat_group = 'clean', 'Never affected', '') AS `Repeats` FROM heat.dash_station_rates ORDER BY mean_rate DESC",
          "refId": "A"
        }
      ]
