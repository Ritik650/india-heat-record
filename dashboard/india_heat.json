            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(makeDate(toUInt16(year), 1, 1)) AS time, avgIf(tmax_share, repeat_group = 'jumped') AS `Stepped at 2011`, avgIf(tmax_share, repeat_group = 'early') AS `Stepped around 1990`, avgIf(tmax_share, repeat_group = 'clean') AS `Never affected`, avgIf(tmin_share, repeat_group = 'jumped') AS `Minimums, 2011 group` FROM heat.dash_repeats WHERE tmax_days >= 500 GROUP BY year ORDER BY year",
          "refId": "A"
        }
      ]
